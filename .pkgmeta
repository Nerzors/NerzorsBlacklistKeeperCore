package-as: NerzorsBlacklistKeeper

# Core-Only ships just the main addon (repo root) plus its shared-assets
# dependency, so this is the only folder to lift back out.
move-folders:
  NerzorsBlacklistKeeper/NerzorsBlacklistKeeper_Data: NerzorsBlacklistKeeper_Data

# Third-party libs are pulled fresh at build time INTO the Data addon - the
# only addon that ships a Libs/ folder and the only one whose TOC loads them.
# (Paths must point there; a bare "Libs/…" would land in the main addon,
# where nothing loads it.) NerzorsUILib-1.0 is ours and stays vendored in the
# repo - deliberately NOT listed here.
externals:
  NerzorsBlacklistKeeper_Data/Libs/LibStub:
    url: https://repos.wowace.com/wow/libstub/trunk
    tag: 1.0
  NerzorsBlacklistKeeper_Data/Libs/CallbackHandler-1.0:
    url: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  NerzorsBlacklistKeeper_Data/Libs/LibSharedMedia-3.0:
    url: https://repos.wowace.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0
  NerzorsBlacklistKeeper_Data/Libs/LibDeflate:
    url: https://github.com/SafeteeWoW/LibDeflate
    tag: latest

enable-nolib-creation: no

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .github
  - .gitignore
  - .gitattributes
  - .tools
  - README.md
  - CHANGELOG.md
