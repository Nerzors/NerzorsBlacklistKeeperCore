package-as: NerzorsBlacklistKeeper

move-folders:
  NerzorsBlacklistKeeper/NerzorsBlacklistKeeper_Data: NerzorsBlacklistKeeper_Data

externals:
  NerzorsBlacklistKeeper_Data/Libs/LibStub:
    url: https://repos.wowace.com/wow/libstub/trunk
    tag: 1.0
  NerzorsBlacklistKeeper_Data/Libs/CallbackHandler-1.0:
    url: https://repos.wowace.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  NerzorsBlacklistKeeper_Data/Libs/LibSharedMedia-3.0:
    url: https://repos.wowace.com/wow/libsharedmedia-3-0/trunk/LibSharedMedia-3.0
  NerzorsBlacklistKeeper_Data/Libs/LibDeflate:
    url: https://github.com/SafeteeWoW/LibDeflate
    tag: latest

enable-nolib-creation: no

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .github
  - .gitignore
  - .gitattributes
  - .tools
  - README.md
  - CHANGELOG.md
