<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

  <!-- Theme.lua: UI bootstrap (NBK.UI namespace, icon resolver, theme
       persistence). ClassIcon.lua: the one addon-specific widget that
       stays out of NerzorsUILib (it depends on NBK.CLASS_SPRITE_* data). -->
  <Script file="Theme.lua"/>
  <Script file="ClassIcon.lua"/>
  <!-- ColumnHeader.lua: shared header-cell behaviour for the list tabs
       (Blacklist, Remember Me, Recents), so narrow icon columns don't each
       reinvent how to render a header that doesn't fit its own label. -->
  <Script file="ColumnHeader.lua"/>
</Ui>