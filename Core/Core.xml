<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

  <!-- NBK Ui -->
  <Script file="Core.lua"/>
  <Script file="Locale.lua"/>
  <Script file="Constants.lua"/>
  <Script file="Database.lua"/>
  <Script file="API.lua"/>
  <!-- Codec.lua (2.5.1 Z1): JSON + zlib + Base64 for the export format of
       NBK V3 ("!NBK:..."); Serializer.lua uses it. -->
  <Script file="Codec.lua"/>
  <Script file="Serializer.lua"/>
  <!-- ForeverNames.lua: kept for good (2.3.0) - switches names saved the
       old WoW: Forever way (docs/game-flavors.md §8). -->
  <Script file="ForeverNames.lua"/>
  <!-- ForeverRealm.lua (2.4.0 J17): on WoW: Forever the keys leave out the
       server; switches what was saved with one. -->
  <Script file="ForeverRealm.lua"/>
  <!-- PublicAPI.lua: the stable LibNBKApi-1.0 surface for other addons.
       Loads after API.lua/Serializer.lua so NBK:_FireApiEvent exists by
       the time any mutation runs. -->
  <Script file="PublicAPI.lua"/>
  <!-- WhatsNew.lua: the player-facing release-notes table consumed by
       Modules/News and the auto-open-on-version-bump logic. Pure data,
       no behaviour - safe to load this late. -->
  <Script file="WhatsNew.lua"/>
</Ui>
